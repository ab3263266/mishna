DATABASE_URL=postgresql+psycopg://mishnah:mishnah@localhost:5432/mishnah

# Google OAuth (Authorization Code + PKCE)
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxxxxx
GOOGLE_REDIRECT_URI=https://app.example.com/auth/google/callback

# Signing key for our own access tokens. Rotate via JWT_SECRET_PREVIOUS.
JWT_SECRET=change-me-32-bytes-minimum
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Gamification knobs (see services/scoring.py)
BASE_POINTS=10
MISS_PENALTY=15
STREAK_FREEZE_COST=120

# A study session logged before this local hour still counts for the previous
# day - people learn at 01:00 and expect it to close out "today".
DAY_ROLLOVER_HOUR=3
